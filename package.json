{
  "name": "smart-campus-pbl",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,cyan \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
